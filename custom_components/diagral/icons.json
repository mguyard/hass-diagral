{
  "services": {
    "arm_groups": {
      "service": "mdi:home-group-plus"
    },
    "disarm_groups": {
      "service": "mdi:home-group-minus"
    },
    "register_webhook": {
      "service": "mdi:link-variant"
    },
    "unregister_webhook": {
      "service": "mdi:link-variant-off"
    }
  },
  "entity": {
    "sensor": {
      "webhook_status": {
        "default": "mdi:webhook"
      },
      "last_webhook": {
        "default": "mdi:webhook"
      }
    }
  }
}
